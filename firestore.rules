rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Email must be confirmed (Google accounts always are).
    // School email only: replace `return true;` below with a line like:
    //   return request.auth.token.email.matches('.*@(student[.]unilag[.]edu[.]ng|unilag[.]edu[.]ng)$');
    function allowedEmail() {
      return request.auth.token.email_verified == true && schoolEmail();
    }
    function schoolEmail() {
      return true;
    }

    // ---- Found items: only signed-in students/staff (confirmed email) can browse or upload ----
    match /items/{itemId} {
      allow read: if signedIn() && allowedEmail();

      allow create: if signedIn() && allowedEmail()
        && request.resource.data.postedBy == request.auth.uid
        && request.resource.data.status == 'available'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80;

      // Admins and the uploader can edit. Anyone signed in may only flip
      // "available" -> "pending" when they submit a claim.
      allow update: if isAdmin()
        || (signedIn() && resource.data.postedBy == request.auth.uid)
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && resource.data.status == 'available'
            && request.resource.data.status == 'pending');

      allow delete: if isAdmin() || (signedIn() && resource.data.postedBy == request.auth.uid);
    }

    // ---- Full-quality photos of sensitive items (ID cards, ATM cards, documents) ----
    // Only admins, the uploader, and owners whose claim was approved can see them.
    match /privatePhotos/{itemId} {
      allow create: if signedIn() && request.resource.data.postedBy == request.auth.uid;
      allow read: if isAdmin()
        || (signedIn() && resource.data.postedBy == request.auth.uid)
        || (signedIn() && request.auth.uid in resource.data.allowed);
      allow update, delete: if isAdmin() || (signedIn() && resource.data.postedBy == request.auth.uid);
    }

    // ---- Claims (proof of ownership): only the claimant and admins can read ----
    match /claims/{claimId} {
      allow create: if signedIn() && allowedEmail()
        && request.resource.data.claimantUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if isAdmin() || (signedIn() && resource.data.claimantUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ---- "I lost something" reports: private to the student (and admins) ----
    match /lostReports/{reportId} {
      allow create: if signedIn() && allowedEmail() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ---- "Report this post" (one report per person per item) ----
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && reportId == request.resource.data.itemId + '_' + request.auth.uid;
      allow read, delete: if isAdmin();
    }

    // ---- Student profiles: each person can read/edit only their own; admins can read all ----
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.uid == uid;
      allow update: if (signedIn() && request.auth.uid == uid
                        && request.resource.data.uid == resource.data.uid
                        && request.resource.data.email == resource.data.email)
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // ---- Admin list: add documents by hand in the Firebase console (document ID = UID) ----
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
